{
  "name": "push3",
  "version": "0.1.0",
  "description": "Ableton Push 3 beyond Ableton: reusable packages (protocol, web, node) and the 3D twin app",
  "author": "Nicu Chiciuc",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "start": "pnpm --filter push3-twin start",
    "build": "pnpm --filter push3-twin build",
    "bridge": "pnpm --filter @push3/node start",
    "typecheck": "pnpm -r typecheck && tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
