    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "sync": "node ../../scripts/sync-chimera.ts"
  },
  "peerDependencies": {
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
